# ─────────────────────────────────────────────────────────────────────────────
# KIRAPAY Merchant API Key
# Get this from your KIRAPAY merchant dashboard at https://app.kira-pay.com
# ─────────────────────────────────────────────────────────────────────────────

# Server-side only — never exposed to the browser
# Used by the /api/kirapay/create-link serverless function
KIRAPAY_API_KEY=your_kirapay_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# App config
# ─────────────────────────────────────────────────────────────────────────────

# Set to "true" in production to suppress the demo-mode banner
VITE_IS_LIVE=true

# Your app's public URL (used for payment redirect URLs)
VITE_APP_URL=http://localhost:5173

# WalletConnect Project ID — get from https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Solana RPC URL (defaults to mainnet-beta public endpoint if unset)
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
